<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tests of OutboundWatch.Core: the expected lists' rules, the address databases (read from small files made
       here), the watcher (fed made-up connections and events, since the real ones need the network and administrator
       rights), the events' bytes, and the history. They need no network. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Strongthium.OutboundWatch.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OutboundWatch.Core\OutboundWatch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
