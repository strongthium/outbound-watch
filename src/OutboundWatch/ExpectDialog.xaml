<Window x:Class="Strongthium.OutboundWatch.App.ExpectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expect this" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!-- Makes a rule from a connection: how much of where it went to expect (the name, the domain, the address, the
       network, the country or anywhere), from which program, on which port, and the list to put it on. The rule is
       shown as it will be written, and can be changed before it's added. -->
  <StackPanel Margin="24,20,24,20">
    <TextBlock x:Name="Heading" Style="{StaticResource Heading}" TextWrapping="Wrap" />
    <TextBlock x:Name="Subheading" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,16" />

    <TextBlock Text="Where it goes" FontWeight="SemiBold" Margin="0,0,0,6" />
    <StackPanel x:Name="Choices" Margin="0,0,0,14" />

    <CheckBox x:Name="OnlyProgram" Checked="Changed" Unchecked="Changed" Margin="0,0,0,4" />
    <CheckBox x:Name="OnlyPort" Checked="Changed" Unchecked="Changed" Margin="0,0,0,16" />

    <TextBlock Text="The rule" FontWeight="SemiBold" Margin="0,0,0,6" />
    <TextBox x:Name="RuleBox" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextChanged="Rule_Changed" />
    <TextBlock x:Name="RuleError" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />

    <TextBlock Text="On the list" FontWeight="SemiBold" Margin="0,16,0,6" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="ListBox" SelectionChanged="List_Changed" />
      <TextBox Grid.Column="2" x:Name="NewName" Visibility="Hidden" ToolTip="The new list's name" />
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button x:Name="AddButton" Content="Add the rule" Padding="18,6" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Add_Click" />
      <Button Content="Cancel" Padding="18,6" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
