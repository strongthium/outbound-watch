<UserControl x:Class="Strongthium.OutboundWatch.App.LivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The connections open now, read again every second: the program, where it goes (the name looked up, the address,
       the network and the country), how long it has been open, the bytes each way and how fast, and whether it's on an
       expected list. A ListView of lines, so that only the lines on screen are made. -->
  <DockPanel Margin="32,26,20,0">
    <Grid DockPanel.Dock="Top" Margin="0,0,12,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Live" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="CountText" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <CheckBox x:Name="UnexpectedOnly" Content="Unexpected only" Margin="0,0,16,0" Checked="Filter_Changed" Unchecked="Filter_Changed" />
        <Grid Width="240">
          <TextBox x:Name="Search" TextChanged="Filter_Changed" ToolTip="A program, name, address, network, AS number, country or port" />
          <TextBlock Text="Search" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource Muted}"
                     Visibility="{Binding Text.IsEmpty, ElementName=Search, Converter={StaticResource VisibleIf}}" />
        </Grid>
      </StackPanel>
    </Grid>

    <!-- The address databases: none yet, or being read. -->
    <Border DockPanel.Dock="Top" x:Name="PlacesCard" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,12,14" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="&#xE909;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <TextBlock Grid.Column="1" x:Name="PlacesText" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="2" x:Name="DownloadButton" Content="Download" Margin="14,0,0,0" Padding="14,5" Style="{DynamicResource AccentButtonStyle}" Click="Download_Click" />
      </Grid>
    </Border>

    <!-- The totals now. -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,12,14">
      <StackPanel Orientation="Horizontal">
        <StackPanel>
          <TextBlock x:Name="OpenStat" Style="{StaticResource Stat}" />
          <TextBlock Text="open now" Style="{StaticResource Caption}" />
        </StackPanel>
        <Border Style="{StaticResource Divider}" />
        <StackPanel>
          <TextBlock x:Name="UnexpectedStat" Style="{StaticResource Stat}" />
          <TextBlock x:Name="UnexpectedCaption" Text="not on an expected list" Style="{StaticResource Caption}" />
        </StackPanel>
        <Border Style="{StaticResource Divider}" />
        <StackPanel>
          <TextBlock x:Name="PlacesStat" Style="{StaticResource Stat}" />
          <TextBlock x:Name="PlacesCaption" Style="{StaticResource Caption}" />
        </StackPanel>
        <Border Style="{StaticResource Divider}" />
        <StackPanel>
          <TextBlock x:Name="ReceivedStat" Style="{StaticResource Stat}" />
          <TextBlock Text="received today" Style="{StaticResource Caption}" />
        </StackPanel>
        <Border Style="{StaticResource Divider}" />
        <StackPanel>
          <TextBlock x:Name="SentStat" Style="{StaticResource Stat}" />
          <TextBlock Text="sent today" Style="{StaticResource Caption}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ListView x:Name="List" BorderThickness="0" Background="Transparent" SelectionMode="Single"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
              MouseDoubleClick="List_MouseDoubleClick" ContextMenuOpening="List_ContextMenuOpening">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="MinHeight" Value="44" />
          <Setter Property="Padding" Value="6,2" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Expect this…" Click="Expect_Click">
            <MenuItem.Icon><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="History of this destination" Click="History_Click">
            <MenuItem.Icon><TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="Copy address" Click="CopyAddress_Click" />
          <MenuItem x:Name="CopyNameItem" Header="Copy name" Click="CopyName_Click" />
          <MenuItem x:Name="ShowProgramItem" Header="Show the program in Explorer" Click="ShowProgram_Click" />
        </ContextMenu>
      </ListView.ContextMenu>
      <ListView.View>
        <GridView AllowsColumnReorder="False">
          <GridViewColumn Width="155">
            <GridViewColumn.Header><GridViewColumnHeader Tag="Program" Click="Header_Click" HorizontalContentAlignment="Left" Content="Program" /></GridViewColumn.Header>
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel ToolTip="{Binding ProgramTip}">
                  <TextBlock Text="{Binding Program}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ProgramDetail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Width="240">
            <GridViewColumn.Header><GridViewColumnHeader Tag="Destination" Click="Header_Click" HorizontalContentAlignment="Left" Content="Destination" /></GridViewColumn.Header>
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Destination}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding DestinationDetail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Width="165">
            <GridViewColumn.Header><GridViewColumnHeader Tag="Org" Click="Header_Click" HorizontalContentAlignment="Left" Content="Network" /></GridViewColumn.Header>
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Org}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding OrgDetail}" Style="{StaticResource Caption}" />
                </StackPanel>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Width="110">
            <GridViewColumn.Header><GridViewColumnHeader Tag="Country" Click="Header_Click" HorizontalContentAlignment="Left" Content="Country" /></GridViewColumn.Header>
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Country}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CountryCode}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Width="92">
            <GridViewColumn.Header><GridViewColumnHeader Tag="Duration" Click="Header_Click" HorizontalContentAlignment="Right" Content="Open for" /></GridViewColumn.Header>
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DurationText}" HorizontalAlignment="Right" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Width="80">
            <GridViewColumn.Header><GridViewColumnHeader Tag="Sent" Click="Header_Click" HorizontalContentAlignment="Right" Content="Sent" /></GridViewColumn.Header>
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding SentText}" HorizontalAlignment="Right" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Width="88">
            <GridViewColumn.Header><GridViewColumnHeader Tag="Received" Click="Header_Click" HorizontalContentAlignment="Right" Content="Received" /></GridViewColumn.Header>
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding ReceivedText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Width="80">
            <GridViewColumn.Header><GridViewColumnHeader Tag="Rate" Click="Header_Click" HorizontalContentAlignment="Right" Content="Now" /></GridViewColumn.Header>
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding RateText}" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Width="120">
            <GridViewColumn.Header><GridViewColumnHeader Tag="Verdict" Click="Header_Click" HorizontalContentAlignment="Left" Content="Expected" /></GridViewColumn.Header>
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                             Visibility="{Binding IsUnexpected, Converter={StaticResource VisibleIf}}" />
                  <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                             Visibility="{Binding IsExpected, Converter={StaticResource VisibleIf}}" />
                  <TextBlock Text="{Binding VerdictText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</UserControl>
