<UserControl x:Class="Strongthium.OutboundWatch.App.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- What's watched and how, the address databases, the tray's messages, the history kept, starting at sign-in, and
       where it's all kept. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,26,32,32" MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,18" />

      <!-- Watching -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Watching" Style="{StaticResource Heading}" Margin="0,0,0,8" />
          <TextBlock x:Name="ModeText" TextWrapping="Wrap" />
          <Button x:Name="AdminButton" Margin="0,12,0,0" Padding="12,5" HorizontalAlignment="Left" Click="Admin_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
              <TextBlock Text="Restart as administrator" />
            </StackPanel>
          </Button>
          <CheckBox x:Name="LocalNetwork" Margin="0,14,0,0" Click="LocalNetwork_Click"
                    Content="Watch connections inside the local network too (the router, a NAS, other PCs)" />
          <CheckBox x:Name="Reverse" Margin="0,8,0,0" Click="Reverse_Click"
                    Content="Look up the name of an address when no lookup of it was seen (a reverse lookup, through the PC's own DNS)" />
        </StackPanel>
      </Border>

      <!-- Notifications -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Unexpected connections" Style="{StaticResource Heading}" Margin="0,0,0,8" />
          <CheckBox x:Name="Notify" Click="Notify_Click"
                    Content="Tell me in the tray when a program connects somewhere that isn't on an expected list" />
          <TextBlock Style="{StaticResource Caption}" Margin="28,4,0,0"
                     Text="Each program and destination once in six hours. Nothing is told until a list is turned on, on the Expected page." />
        </StackPanel>
      </Border>

      <!-- The address databases -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Countries and networks" Style="{StaticResource Heading}" Margin="0,0,0,8" />
          <TextBlock x:Name="PlacesText" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="DownloadButton" Padding="12,5" Click="Download_Click" />
            <TextBlock x:Name="DownloadStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>
          <CheckBox x:Name="UpdatePlaces" Margin="0,12,0,0" Click="UpdatePlaces_Click" Content="Download each month's new ones" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0">
            <Run Text="IP geolocation and network data by" />
            <Hyperlink NavigateUri="https://db-ip.com" RequestNavigate="Link_RequestNavigate">DB-IP</Hyperlink><Run Text=", under" />
            <Hyperlink NavigateUri="https://creativecommons.org/licenses/by/4.0/" RequestNavigate="Link_RequestNavigate">CC BY 4.0</Hyperlink><Run Text=". The files come from download.db-ip.com, and nothing else is ever sent there." />
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- History -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="History" Style="{StaticResource Heading}" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Keep" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="Keep" Width="160" SelectionChanged="Keep_Changed" />
          </StackPanel>
          <TextBlock x:Name="HistoryText" Style="{StaticResource Caption}" Margin="0,10,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Open the folder" Padding="12,5" Click="OpenFolder_Click" />
            <Button Content="Clear the history…" Padding="12,5" Margin="8,0,0,0" Click="Clear_Click" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Starting -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Starting" Style="{StaticResource Heading}" Margin="0,0,0,8" />
          <CheckBox x:Name="StartAtSignIn" Click="StartAtSignIn_Click" Content="Start outbound-watch in the tray when I sign in" />
          <TextBlock x:Name="AutostartText" Style="{StaticResource Caption}" Margin="28,4,0,0" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="4,8,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
